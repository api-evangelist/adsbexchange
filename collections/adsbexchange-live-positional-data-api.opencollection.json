        {
          "info": {
            "name": "Get all aircraft",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.adsbexchange.com/api/aircraft/v2/all",
            "headers": [
              {
                "name": "Accept-Encoding",
                "value": "gzip"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns all aircraft currently being tracked.\n\nNote: This endpoint can be slow or unresponsive in Swagger UI due to the large volume of data returned. For best results, use an external tool (like Postman or curl)."
        },
        {
          "info": {
            "name": "Get total aircraft",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.adsbexchange.com/api/aircraft/v2/total-aircraft",
            "headers": [
              {
