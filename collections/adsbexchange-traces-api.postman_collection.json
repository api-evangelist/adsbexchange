                  "value": "<string>",
                  "key": "folder",
                  "description": "(Required) Last 2 characters of ICAO code."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "jsonFile",
                  "description": "(Required) Name of the JSON file. Must be in the format 'trace_full_{ICAO}.json'."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The encoding type the client will accept in the response. API call must use compression.",
                "key": "Accept-Encoding",
